{
  "name": "hanpan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HANPAN(한판) - 대전 보드게임 모임 매칭 웹서비스 MVP",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc -b && vite build && node scripts/write-headers.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "tsc -p tsconfig.db.json && vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:csp": "playwright test --config playwright.csp.config.ts",
    "screenshots": "playwright test --project=screenshots",
    "check:seed": "node scripts/check-no-seed.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:builds": "node scripts/check-builds.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build && npm run check:seed && npm run check:dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
