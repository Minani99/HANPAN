# HANPAN 환경 변수 예시
# 이 파일을 복사해 `.env.local`을 만들고 값을 채우세요. `.env.local`은 Git에 커밋되지 않습니다.
# VITE_ 로 시작하는 값은 빌드 결과(브라우저)에 그대로 포함되므로 공개되어도 되는 값만 넣으세요.

# Supabase 프로젝트 URL (예: https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase anon(publishable) 키만 사용하세요.
# service_role 키는 RLS를 우회하므로 절대 여기에 넣거나 브라우저 코드에 포함하지 마세요.
VITE_SUPABASE_ANON_KEY=

# 카카오 로그인 허용 여부 (Supabase Kakao provider 설정을 마친 뒤에만 true)
VITE_AUTH_KAKAO_ENABLED=false

# 서비스 기준 URL (모임 공유 링크용. OAuth 리디렉션은 현재 접속 주소 기준이라 이 값과 무관)
VITE_SITE_URL=http://localhost:5173
